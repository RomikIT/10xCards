---
import Layout from "@/layouts/Layout.astro";
import { GenerateFlashcards } from "@/components/flashcards/GenerateFlashcards";
---

<Layout title="Generate Flashcards">
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Generate Flashcards
        </h1>
        <a href="/flashcards" class="text-sm text-blue-100/70 hover:text-white">← Flashcards</a>
      </div>
      <GenerateFlashcards client:load />
    </div>
  </div>
</Layout>
